# Copy to frontend/.env.local for local development.
# These variables are read only by the Next.js server (the API proxy route).
# Do NOT rename them with a NEXT_PUBLIC_ prefix: that would ship them to the browser.

# Base URL of the FastAPI backend.
# Local development:
BACKEND_URL=http://127.0.0.1:8000

# Shared secret forwarded to the backend as the X-Backend-Key header.
# Must match BACKEND_API_KEY in backend/.env (and in Render).
BACKEND_API_KEY=
