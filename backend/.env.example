# Copy to backend/.env and fill in real values.
# backend/.env is gitignored. Never commit real secrets.

# --- Required ---

# OpenRouter API key used by the backend to call the model.
OPENROUTER_API_KEY=

# Shared secret between the Vercel proxy and this backend.
# Must be identical to BACKEND_API_KEY in frontend/.env.local (and Vercel).
# Generate one locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=

# Comma-separated browser origins allowed by CORS.
# Local development default:
ALLOWED_ORIGINS=http://localhost:3000

# --- Optional tuning (defaults shown) ---

# Set by Render automatically; uncomment locally to force production mode
# (disables /docs, /redoc, /openapi.json).
# ENVIRONMENT=production

# Maximum accepted JSON request body size, in bytes.
# MAX_BODY_BYTES=65536

# AI endpoint rate limits (per client / global, sliding windows).
# AI_LIMIT_PER_HOUR=10
# AI_LIMIT_PER_DAY=30
# AI_GLOBAL_PER_DAY=50

# Repository clone rate limits (per client / global, sliding windows).
# CLONE_LIMIT_PER_HOUR=5
# CLONE_LIMIT_PER_DAY=20
# CLONE_GLOBAL_PER_DAY=30

# Post-clone repository size cap, in bytes (default 150 MB).
# MAX_REPO_BYTES=157286400

# Temporary workspace eviction.
# WORKSPACE_TTL_SECONDS=3600
# MAX_WORKSPACES=50

# OpenRouter client behaviour.
# OPENROUTER_TIMEOUT_SECONDS=120
# OPENROUTER_MAX_RETRIES=1
# OPENROUTER_MODEL=openrouter/free
